generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_ASET
  ADMIN_UNIT
  AUDITOR
  USER
}

enum Condition {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?  @unique
  nip       String?  @unique
  password  String
  role      Role     @default(USER)
  unitId    Int?
  phone     String?
  position  String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      Log[]
  procurements Procurement[]
  validatedAssets Asset[] @relation("AssetValidator")
  vehicleBookings VehicleBooking[]
}

model Unit {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  head      String?
  location  String?
  assets    Asset[]
  rooms     Room[]
  users     User[]
  requests  Request[]
  rkbs      RKB[]
  procurements Procurement[]
}

model Room {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  floor     String
  building  String
  pic       String?
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  assets    Asset[]
}

model Category {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  usefulLife         Int      // In years
  depreciationMethod String   // e.g. STRAIGHT_LINE
  assets             Asset[]
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  contact   String?
  assets           Asset[]
  procurementItems ProcurementItem[]
}

model Asset {
  id              Int      @id @default(autoincrement())
  code            String   @unique // Format: KB-KT-TH-URUT
  name            String
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id])
  roomId          Int?
  room            Room?    @relation(fields: [roomId], references: [id])
  unitId          Int?
  unit            Unit?    @relation(fields: [unitId], references: [id])
  vendorId        Int?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  
  brand           String?
  specification   String?  @db.Text
  purchaseDate    DateTime
  price           Float
  quantity        Int      @default(1)
  usefulLife      Int      @default(5)
  condition       Condition
  sourceOfFunds   String?  @default("Mandiri")
  acquisitionStatus String? @default("Pembelian")
  
  image           String?
  invoice         String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  movements       Movement[]
  maintenances    Maintenance[]
  
  // Validation Fields
  validationStatus ValidationStatus @default(UNVERIFIED)
  validatedAt      DateTime?
  validatedById    Int?
  validatedBy      User?    @relation("AssetValidator", fields: [validatedById], references: [id])
  validationNote   String?
}

enum ValidationStatus {
  UNVERIFIED
  VALIDATED
  NEEDS_UPDATE
  REJECTED
}

model Request {
  id          Int      @id @default(autoincrement())
  itemName    String
  spec        String?
  qty         Int
  priceEst    Float
  urgency     String
  status      String   // e.g. DRAFT, PENDING, APPROVED, PURCHASED
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Movement {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id])
  fromLocation String
  toLocation  String
  date        DateTime @default(now())
  reason      String?
  type        String   // MUTATION, DISPOSAL
}

model Maintenance {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id])
  date        DateTime
  description String
  cost        Float
  status      String
  createdAt   DateTime @default(now())
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Setting {
  id                Int      @id @default(1)
  orgName           String   @default("Manajemen Aset")
  orgAddress        String?  @db.Text
  orgPhone          String?
  orgEmail          String?
  orgLogo           String?  @db.LongText
  orgHeadName       String?
  orgHeadNip        String?
  assetCodePrefix   String   @default("AST")
  updatedAt         DateTime @updatedAt
}

// --- MODULE PENGADAAN (PROCUREMENT) ---

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  APPROVED
  PROCESS
  COMPLETED
  REJECTED
}

enum ProcurementType {
  ASSET
  NON_ASSET
  SERVICE
}

model RKB {
  id          Int       @id @default(autoincrement())
  fiscalYear  Int
  unitId      Int
  unit        Unit      @relation(fields: [unitId], references: [id])
  status      String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  totalBudget Float     @default(0)
  items       RKBItem[]
  procurements Procurement[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RKBItem {
  id          Int      @id @default(autoincrement())
  rkbId       Int
  rkb         RKB      @relation(fields: [rkbId], references: [id])
  name        String
  spec        String?  // Spesifikasi
  qty         Int
  unit        String   // Satuan (Unit, Pcs, Box)
  estPrice    Float
  category    String   // ASSET / NON_ASSET
  priority    String   // HIGH, MEDIUM, LOW
  month       Int?     // 1-12
}

model Procurement {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. REQ/2024/001
  title       String?   // Judul Pengajuan (e.g. Pengadaan Laptop Divisi IT)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  unitId      Int
  unit        Unit      @relation(fields: [unitId], references: [id])
  
  type        ProcurementType
  status      ProcurementStatus @default(DRAFT)
  
  rkbId       Int?
  rkb         RKB?      @relation(fields: [rkbId], references: [id])
  
  validationNote String?
  rejectionReason String?
  
  bastDate    DateTime?
  bastFile    String?
  
  items       ProcurementItem[]
  offers      VendorOffer[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProcurementItem {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  name          String
  spec          String?     @db.Text
  qty           Int
  unit          String      // pcs, set, unit
  estPrice      Float       @default(0)
  
  // New Fields for Detailed Processing
  fundingSource String?     // Sumber Dana per item
  comparisonVendors String? @db.Text // JSON String: [{ name, price, notes }, ...]
  needComparison Boolean @default(true) // Perlu perbandingan harga?
  
  // Post-Approval Fields
  vendorId      Int?
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])
  brand         String?     // Merk/Type
  usefulLife    Int?        // Umur Manfaat (Tahun)
  finalPrice    Float?      // Harga Akhir / Realisasi
}

model VendorOffer {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  vendorId      Int?        // Optional hyperlink to master Vendor
  vendorName    String      // Manual name if vendor not in master
  price         Float
  isWinner      Boolean     @default(false)
  quoteFile     String?
  createdAt     DateTime    @default(now())
}
// --- MANAJEMEN KENDARAAN ---

model Vehicle {
  id            Int       @id @default(autoincrement())
  name          String    // e.g. Toyota Avanza
  type          String    // e.g. Minibus, Pickup, Motorcycle
  plateNumber   String    @unique // Plat Nomor
  brand         String
  year          Int
  color         String?
  chassisNumber String?   // No Rangka
  engineNumber  String?   // No Mesin
  taxDueDate    DateTime? // Pajak Tahunan
  stnkDueDate   DateTime? // Pajak 5 Tahunan
  photo         String?
  status        String    @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE
  
  // Relations
  assetId       Int?      @unique // Optional link to Asset table
  bookings      VehicleBooking[]
  services      VehicleService[]
  fuelLogs      VehicleFuelLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VehicleBooking {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  driverName  String?  // If driver is external or specific
  destination String
  purpose     String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  adminNote   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VehicleService {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  date        DateTime
  type        String   // SERVICE_RUTIN, GANTI_OLI, PAJAK, OTHER
  description String
  cost        Float
  odometer    Int?
  workshop    String?  // Bengkel
  proofFile   String?  // Foto Nota
  
  createdAt   DateTime @default(now())
}

model VehicleFuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  date        DateTime
  liters      Float
  cost        Float
  odometer    Int
  proofFile   String?
  
  createdAt   DateTime @default(now())
}
