generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BIDANG_IT
  ADMIN_ASET
  KEPALA_BIDANG
  ADMIN_UNIT
  AUDITOR
  USER
  KABID_SARPRAS
}

enum Condition {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  DISPOSED
}

enum DisposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  PENDING
  APPROVED
  BORROWED
  RETURNED
  REJECTED
}

model User {
  id                       Int                    @id @default(autoincrement())
  username                 String                 @unique
  name                     String? // Nama Lengkap
  email                    String?                @unique
  nip                      String?                @unique
  password                 String
  role                     Role                   @default(USER)
  unitId                   Int?
  phone                    String?
  position                 String?
  unit                     Unit?                  @relation(fields: [unitId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  logs                     Log[]
  procurements             Procurement[]
  validatedAssets          Asset[]                @relation("AssetValidator")
  vehicleBookings          VehicleBooking[]
  busBookings              BusBooking[]
  maintenances             Maintenance[]
  inspections              VehicleInspection[]
  warehouseTransactions    WarehouseTransaction[]
  requestedMovements       Movement[]             @relation("RequestedMovements")
  approvedMovements        Movement[]             @relation("ApprovedMovements")
  personnelReports         PersonnelReport[]
  assignedAssignments      PersonnelAssignment[]  @relation("Assignee")
  createdAssignments       PersonnelAssignment[]  @relation("Assigner")
  assignedProcurementItems ProcurementItem[]      @relation("ItemAssignee")
  vehicleWeeklyReports     VehicleWeeklyReport[]
  authorizedDisposals      AssetDisposal[]        @relation("Reviewer")
  proposedDisposals        AssetDisposal[]        @relation("Proposer")
  sarprasRules             SarprasRule[]
  assetsPIC                Asset[]                @relation("AssetPIC")
  calendarEventsCreated    SarprasCalendarEvent[] @relation("CalendarCreator")
  calendarEventsPIC        SarprasCalendarEvent[] @relation("CalendarPICs")
  notifications            Notification[]

  loans         AssetLoan[] @relation("Borrower")
  reviewedLoans AssetLoan[] @relation("LoanReviewer")

  vehiclesPIC           Vehicle[]        @relation("VehiclePICs")
  vehicleDriverBookings VehicleBooking[] @relation("VehicleDriver")
  busDriverBookings     BusBooking[]     @relation("BusDriver")

  // Personnel Module Extensions
  assignedRoutines PersonnelRoutine[] @relation("RoutineAssignee")
  createdRoutines  PersonnelRoutine[] @relation("RoutineAssigner")
  personnelKPIs      PersonnelKPI[]
  pushSubscriptions  PushSubscription[]

  // E-Office Module
  officeDocumentsAuthored OfficeDocument[] @relation("OfficeDocumentAuthor")
  officeDocumentsSigned   OfficeDocument[] @relation("OfficeDocumentSigner")


  // Driver Extensions
  licenseNumber    String?
  licenseType      String? // e.g., SIM A, SIM B1, SIM B2
  licenseExpiry    DateTime?
  driverStatus     String   @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFF
  driverViolations DriverViolation[]
}

model DriverViolation {
  id          Int      @id @default(autoincrement())
  driverId    Int
  driver      User     @relation(fields: [driverId], references: [id])
  date        DateTime
  category    String   // e.g., Keterlambatan, Kelengkapan, Lalu Lintas, Kerusakan
  description String   @db.Text
  sanction    String   // e.g., Teguran Lisan, SP1, SP2
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String   @db.Text
  type      String // INFO, WARNING, SUCCESS, URGENT
  isRead    Boolean  @default(false)
  link      String? // URL to redirect when clicked
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @db.Text
  keys      Json
  createdAt DateTime @default(now())

  @@unique([userId, endpoint(length: 500)])
}

model Unit {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
  phone       String?
  email       String?
  address     String? @db.Text
  headName    String? // Nama Kepala Unit
  headNip     String? // NIP Kepala Unit
  logo        String? @db.LongText // Logo Unit (Base64)

  assets      Asset[]
  rooms       Room[]
  targetLoans AssetLoan[] @relation("TargetUnit")

  loans        AssetLoan[]   @relation("UnitLoans")
  users        User[]
  requests     Request[]
  rkbs         RKB[]
  procurements Procurement[]
  maintenances Maintenance[]

}

model Room {
  id       Int     @id @default(autoincrement())
  code     String  @unique
  name     String
  floor    String
  building String
  pic      String?
  unitId   Int?
  unit     Unit?   @relation(fields: [unitId], references: [id])
  assets   Asset[]
}

model Category {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  name               String
  usefulLife         Int // In years
  depreciationMethod String // e.g. STRAIGHT_LINE
  assets             Asset[]
  procurementItems   ProcurementItem[]
}

model Vendor {
  id          Int     @id @default(autoincrement())
  name        String
  address     String? @db.Text
  phone       String?
  email       String?
  website     String?
  description String? @db.Text
  photo       String? @db.LongText
  category    String? // e.g., IT, Alat Tulis, Meubel
  isVerified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  procurementItems ProcurementItem[]
  products         VendorProduct[]
}

model VendorProduct {
  id            Int     @id @default(autoincrement())
  vendorId      Int
  vendor        Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name          String
  price         Float?
  specification String? @db.Text
  image         String? @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  priceHistory VendorPriceHistory[]
}

model VendorPriceHistory {
  id        Int           @id @default(autoincrement())
  productId Int
  product   VendorProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Float
  date      DateTime      @default(now())
}

model Asset {
  id         Int      @id @default(autoincrement())
  code       String   @unique // Format: KB-KT-TH-URUT
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  roomId     Int?
  room       Room?    @relation(fields: [roomId], references: [id])
  unitId     Int?
  unit       Unit?    @relation(fields: [unitId], references: [id])
  vendorName String? // Standalone vendor name (not linked to Vendor table)

  brand             String?
  specification     String?   @db.Text
  purchaseDate      DateTime
  price             Float
  quantity          Int       @default(1)
  usefulLife        Int       @default(5)
  condition         Condition
  sourceOfFunds     String?   @default("Mandiri")
  acquisitionStatus String?   @default("Pembelian")
  isLendable        Boolean   @default(false)

  image   String? @db.LongText
  invoice String? @db.LongText

  // PIC (Person In Charge)
  picId   Int?
  pic     User?   @relation("AssetPIC", fields: [picId], references: [id])
  picName String? // For custom PIC names not in system

  // Prediction Fields
  nextMaintenanceEst  DateTime?
  maintenanceInterval Int?      @default(180) // Default 180 days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements    Movement[]
  maintenances Maintenance[]
  disposal     AssetDisposal?
  loans        AssetLoan[]

  // Validation Fields
  validationStatus   ValidationStatus @default(UNVERIFIED)
  validatedAt        DateTime?
  validatedById      Int?
  validatedBy        User?            @relation("AssetValidator", fields: [validatedById], references: [id])
  validationNote     String?
  notificationSent   Boolean          @default(false)

  // Maintenance Planning
  needsRoutineMaintenance Boolean @default(false)
}

enum ValidationStatus {
  UNVERIFIED
  VALIDATED
  NEEDS_UPDATE
  REJECTED
}

model Request {
  id        Int      @id @default(autoincrement())
  itemName  String
  spec      String?
  qty       Int
  priceEst  Float
  urgency   String
  status    String // e.g. DRAFT, PENDING, APPROVED, PURCHASED
  unitId    Int
  unit      Unit     @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movement {
  id           Int       @id @default(autoincrement())
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id])
  fromLocation String
  toLocation   String
  toRoomId     Int?
  toUnitId     Int? // New: For Inter-Unit Mutation
  date         DateTime  @default(now())
  reason       String?
  type         String    @default("MUTATION") // MUTATION, DISPOSAL
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterId  Int
  requester    User      @relation("RequestedMovements", fields: [requesterId], references: [id])
  approverId   Int?
  approver     User?     @relation("ApprovedMovements", fields: [approverId], references: [id])
  approvalDate DateTime?
  approvalNote String?
}

enum MaintenanceCategory {
  ROUTINE
  INCIDENTAL
}

model Maintenance {
  id     Int    @id @default(autoincrement())
  code   String @unique // e.g. MT/2026/001
  userId Int
  user   User   @relation(fields: [userId], references: [id])
  unitId Int
  unit   Unit   @relation(fields: [unitId], references: [id])

  type     String // "ASSET" or "NON_ASSET"
  category MaintenanceCategory @default(INCIDENTAL)
  targetDept String              @default("SARPRAS") // SARPRAS or PEMBANGUNAN
  urgency  String              @default("NORMAL") // e.g. NORMAL, URGENT, EMERGENCY
  assets   Asset[]

  title       String // Judul Ringkas
  description String  @db.Text // Keluhan / Masalah
  location    String? // Lokasi (for non-asset)
  photo       String? @db.LongText // Foto bukti kerusakan (Base64)
  media       Json? // Array of { type: 'IMAGE' | 'VIDEO', url: '...' }

  status String @default("SUBMITTED")
  // SUBMITTED -> APPROVED -> VALIDATED -> ASSIGNED -> IN_PROGRESS -> COMPLETED / REJECTED

  // Workflow Fields
  approvalNote    String?
  validationNote  String?
  rejectionReason String?
  technician      String? // Nama Teknisi / Vendor
  actionTaken     String?   @db.Text // Tindakan Perbaikan
  completionNote  String?   @db.Text
  completionDate  DateTime?
  cost            Float     @default(0)
  costDetails     Json?     // Array of { label: string, price: number, assetId: number | null }

  aiDiagnosis Json? // AI Diagnosis Results (Diagnosis, Severity, Actions)
  isDirectOrder Boolean @default(false)
  quickToken     String? @unique // Token for quick update via WA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Setting {
  id              Int      @id @default(1)
  orgName         String   @default("Manajemen Aset")
  orgAddress      String?  @db.Text
  orgPhone        String?
  orgEmail        String?
  orgLogo         String?  @db.LongText
  orgHeadName     String?
  orgHeadNip      String?
  assetCodePrefix String   @default("AST")
  busInitialFund  Float    @default(0) // Dana awal operasional Bus
  updatedAt       DateTime @updatedAt
}

// --- MODULE PENGADAAN (PROCUREMENT) ---

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  APPROVED
  PROCESS
  COMPLETED
  REJECTED
}

enum ProcurementType {
  ASSET
  NON_ASSET
  SERVICE
}

model RKB {
  id           Int           @id @default(autoincrement())
  fiscalYear   Int
  unitId       Int
  unit         Unit          @relation(fields: [unitId], references: [id])
  status       String        @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  totalBudget  Float         @default(0)
  items        RKBItem[]
  procurements Procurement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model RKBItem {
  id       Int     @id @default(autoincrement())
  rkbId    Int
  rkb      RKB     @relation(fields: [rkbId], references: [id])
  name     String
  spec     String? // Spesifikasi
  qty      Int
  unit     String // Satuan (Unit, Pcs, Box)
  estPrice Float
  category String // ASSET / NON_ASSET
  priority String // HIGH, MEDIUM, LOW
  month    Int? // 1-12
}

model Procurement {
  id     Int     @id @default(autoincrement())
  code   String  @unique // e.g. REQ/2024/001
  title  String? // Judul Pengajuan (e.g. Pengadaan Laptop Divisi IT)
  userId Int
  user   User    @relation(fields: [userId], references: [id])
  unitId Int
  unit   Unit    @relation(fields: [unitId], references: [id])

  type   ProcurementType
  status ProcurementStatus @default(DRAFT)

  rkbId Int?
  rkb   RKB? @relation(fields: [rkbId], references: [id])

  validationNote  String?
  rejectionReason String?

  bastDate DateTime?
  bastFile String?   @db.LongText

  items  ProcurementItem[]
  offers VendorOffer[]

  isDirectOrder Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProcurementItem {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  name          String
  spec          String?     @db.Text
  qty           Int
  unit          String // pcs, set, unit
  estPrice      Float       @default(0)

  // New Fields for Detailed Processing
  fundingSource     String? // Sumber Dana per item
  comparisonVendors String? @db.Text // JSON String: [{ name, price, notes }, ...]
  needComparison    Boolean @default(true) // Perlu perbandingan harga?

  // Post-Approval Fields
  vendorId   Int?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])
  vendorName String? // Nama vendor (teks, tanpa relasi ke tabel Vendor master)
  brand      String? // Merk/Type
  usefulLife Int? // Umur Manfaat (Tahun)
  finalPrice Float? // Harga Akhir / Realisasi

  // Assignment Fields
  assignedTo     String? // Nama (Internal/Manual)
  assignedToId   Int?
  assignedToUser User?   @relation("ItemAssignee", fields: [assignedToId], references: [id])
  assignmentNote String? @db.Text

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model VendorOffer {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  vendorId      Int? // Optional hyperlink to master Vendor
  vendorName    String // Manual name if vendor not in master
  price         Float
  isWinner      Boolean     @default(false)
  quoteFile     String?
  createdAt     DateTime    @default(now())
}

// --- MANAJEMEN KENDARAAN ---

model Vehicle {
  id                 Int     @id @default(autoincrement())
  name               String // Nama
  brand              String // Merk
  model              String? // Model
  type               String // Tipe Kendaraan (e.g. Minibus, Pickup, Motor)
  plateNumber        String  @unique // Plat Nomor
  fuelType           String? // Bahan Bakar
  capacity           String? // Kapasitas (e.g. 1500cc)
  color              String? // Warna
  odometer           Int     @default(0) // Kilometer saat ini
  photo              String? @db.LongText // Foto Kendaraan (Base64 support)
  status             String  @default("ACTIVE") // ACTIVE / INACTIVE
  isRentable         Boolean @default(false) // Bisa disewa atau tidak
  defaultRentalPrice Float? // Biaya Sewa Default per hari
  lastFuelCondition  String? // Kondisi BBM terakhir (LOW, MEDIUM, HIGH)

  // Additional fields (kept from previous version)
  year          Int?
  chassisNumber String? // No Rangka
  engineNumber  String? // No Mesin
  taxDueDate    DateTime? // Pajak Tahunan
  stnkDueDate   DateTime? // Pajak 5 Tahunan
  kirDueDate    DateTime? // Jadwal KIR (Optional)

  // Relations
  assetId       Int?                  @unique // Optional link to Asset table
  bookings      VehicleBooking[]
  busBookings   BusBooking[]
  pics          User[]                @relation("VehiclePICs")
  services      VehicleService[]
  fuelLogs      VehicleFuelLog[]
  weeklyReports VehicleWeeklyReport[]
  inspections   VehicleInspection[]
  maintenanceReminders VehicleMaintenanceReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Notification Tracking
  lastKmNotifiedAt DateTime? // Track last time KM service warning was sent
}

model VehicleWeeklyReport {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  weekStartDate DateTime
  weekEndDate   DateTime

  startOdometer Int
  endOdometer   Int

  conditionEngine   String // e.g. BAIK, PERLU PERBAIKAN
  conditionBody     String
  conditionInterior String
  isClean           Boolean @default(true)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleInspection {
  id        Int     @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id])

  frontPhoto String? @db.LongText
  rightPhoto String? @db.LongText
  leftPhoto  String? @db.LongText
  backPhoto  String? @db.LongText

  scratches Json? // Array of { side, x, y, severity }

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
}

model VehicleBooking {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  driverName  String? // If driver is external or specific
  destination String
  purpose     String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  adminNote   String?


  isRented    Boolean @default(false) // Whether this booking is a rental
  rentalPrice Float? // Price for rental if applicable

  passengerCount Int   @default(0)
  driverId       Int?
  driver         User? @relation("VehicleDriver", fields: [driverId], references: [id])

  startKm       Int?
  endKm         Int?
  tripNotes     String?   @db.Text
  fuelRefill    Boolean   @default(false)
  fuelPrice     Float     @default(0)
  fuelLiters    Float? // Amount in liters if refilled during trip
  fuelCondition String?   // Kondisi BBM di akhirjalanan (LOW, MEDIUM, HIGH)
  tripStartTime DateTime?
  tripEndTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleService {
  id                  Int      @id @default(autoincrement())
  vehicleId           Int
  vehicle             Vehicle  @relation(fields: [vehicleId], references: [id])
  date                DateTime
  category            String   @default("ROUTINE") // ROUTINE, NON_ROUTINE
  type                String // SERVICE_RUTIN, GANTI_OLI, PAJAK, PERBAIKAN, OTHER
  description         String   @db.Text
  cost                Float
  odometer            Int?
  nextServiceOdometer Int? // KM service berikutnya (Routine only)
  nextServiceDate     DateTime? // Tanggal service berikutnya (hybrid reminder)
  items               Json? // Array of { name, cost, nextKm?, nextDate?, isRoutine }
  workshop            String? // Bengkel
  proofFile           String? // Foto Nota

  createdAt DateTime @default(now())
}

model VehicleMaintenanceReminder {
  id              Int       @id @default(autoincrement())
  vehicleId       Int
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  componentName   String    // e.g. "Oli Mesin", "Kampas Rem", "Aki"
  lastServicedKm  Int?      // KM saat terakhir servis
  lastServicedDate DateTime? // Tanggal terakhir servis
  intervalKm      Int?      // Interval KM (e.g. 5000)
  intervalMonths  Int?      // Interval bulan (e.g. 6)
  targetKm        Int?      // KM target berikutnya
  targetDate      DateTime? // Tanggal target berikutnya
  lastCost        Float?    // Biaya terakhir
  status          String    @default("OK") // OK, WARNING, OVERDUE
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([vehicleId, componentName])
  @@index([vehicleId])
}

model VehicleFuelLog {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  date      DateTime
  liters    Float
  cost      Float
  odometer  Int
  proofFile String?

  createdAt DateTime @default(now())
}

// --- MANAJEMEN GUDANG & LOGISTIK ---

model WarehouseCategory {
  id    Int             @id @default(autoincrement())
  name  String          @unique // "Seragam", "Perlengkapan Sekolah"
  items WarehouseItem[]
}

model WarehouseItem {
  id         Int               @id @default(autoincrement())
  code       String            @unique // GD/SRG/001
  name       String // "Baju Putih", "Buku Tulis"
  categoryId Int
  category   WarehouseCategory @relation(fields: [categoryId], references: [id])

  type         String? // BAJU, CELANA, JILBAB (seragam only)
  gender       String? // L, P (seragam only)
  size         String? // S, M, L, XL, XXL (seragam only)
  purchaseYear Int? // Tahun pembuatan/pembelian batch (wajib utk seragam)
  itemUnit     String? // Unit seragam: TK, TAUD, SD, SMP, SMA, dll
  uniformGroup String? // Nasional, Batik, Muslim, Pramuka, Olahraga, Jubah Hitam, Jubah Putih

  stock         Int     @default(0)
  minStock      Int     @default(5)
  purchasePrice Float? // Harga beli per unit
  supplier      String? // Pemasok
  location      String? // Rak / lokasi gudang
  image         String? @db.LongText

  transactionItems WarehouseTransactionItem[]
  orderItems       UniformOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseTransaction {
  id          Int      @id @default(autoincrement())
  code        String   @unique // TRX/2026/001
  type        String // "IN" or "OUT"
  date        DateTime
  note        String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  items WarehouseTransactionItem[]

  createdAt DateTime @default(now())
}

model WarehouseTransactionItem {
  id            Int                  @id @default(autoincrement())
  transactionId Int
  transaction   WarehouseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemId        Int
  item          WarehouseItem        @relation(fields: [itemId], references: [id])
  quantity      Int
  recipientName String? // Penerima (for OUT)
  recipientUnit String? // Unit penerima
}

// --- PESANAN SERAGAM PUBLIK ---

model UniformOrder {
  id            Int                @id @default(autoincrement())
  code          String             @unique // ORD/2026/001
  customerName  String // Nama pemesan (ortu/wali)
  customerPhone String // No HP pemesan
  customerUnit  String // Unit: TK, SD, SMP, dll
  studentName   String // Nama siswa
  studentClass  String? // Kelas
  note          String?            @db.Text
  status        String             @default("PENDING") // PENDING, CONFIRMED, READY, PICKED_UP, CANCELLED
  totalAmount   Float              @default(0)
  items         UniformOrderItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model UniformOrderItem {
  id            Int            @id @default(autoincrement())
  orderId       Int
  order         UniformOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int? // Made optional for decoupled orders
  item          WarehouseItem? @relation(fields: [itemId], references: [id])
  itemName      String? // For decoupled orders
  size          String? // For decoupled orders
  quantity      Int
  price         Float          @default(0)
  status        String         @default("PENDING") // PENDING, READY, NO_STOCK, DONE
  pickupDetails String?        @db.Text
}

enum ReportType {
  DAILY
  WEEKLY
  PLAN
}

enum PersonnelReportCategory {
  KEUANGAN
  ASET
  GUDANG
  KENDARAAN
  UMUM
}

model PersonnelReport {
  id        Int                     @id @default(autoincrement())
  userId    Int
  user      User                    @relation(fields: [userId], references: [id])
  type      ReportType
  category  PersonnelReportCategory @default(UMUM)
  content   String                  @db.Text
  metadata  Json? // Structured data for specific categories
  date      DateTime                @default(now())
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  LIBUR
}

model PersonnelAssignment {
  id                   Int              @id @default(autoincrement())
  assignerId           Int
  assigner             User             @relation("Assigner", fields: [assignerId], references: [id])
  assigneeId           Int
  assignee             User             @relation("Assignee", fields: [assigneeId], references: [id])
  title                String
  description          String           @db.Text
  category             String           @default("UMUM")
  priority             String           @default("MEDIUM")
  location             String?
  startDate            DateTime?
  dueDate              DateTime?
  status               AssignmentStatus @default(PENDING)
  actualStartDate      DateTime?
  actualCompletionDate DateTime?
  progressPercentage   Int              @default(0)
  notes                String?          @db.Text
  items                Json?            @default("[]")
  lastReminderSent     DateTime?

  // Extension Request
  requestedExtensionDate DateTime?
  extensionReason        String?   @db.Text
  extensionStatus        String? // PENDING, APPROVED, REJECTED

  calendarEventId Int?
  calendarEvent   SarprasCalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  routineId Int?
  routine   PersonnelRoutine? @relation(fields: [routineId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetDisposal {
  id              Int            @id @default(autoincrement())
  assetId         Int            @unique
  asset           Asset          @relation(fields: [assetId], references: [id])
  disposalDate    DateTime?
  reason          String
  method          String?
  notes           String?        @db.Text
  status          DisposalStatus @default(PENDING)
  proposedById    Int
  proposedBy      User           @relation("Proposer", fields: [proposedById], references: [id])
  reviewedById    Int?
  reviewedBy      User?          @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model SarprasRule {
  id          Int            @id @default(autoincrement())
  title       String
  category    String         @default("Umum")
  folderId    Int?
  folder      SarprasFolder? @relation(fields: [folderId], references: [id])
  description String?        @db.Text

  // New Metadata Fields
  documentNumber String? // Nomor Surat/Dokumen
  status         String    @default("Berlaku") // Berlaku, Arsip, Draft
  expiryDate     DateTime? // Tanggal Kadaluarsa
  isPublic       Boolean   @default(true)

  fileUrl      String   @db.LongText
  fileName     String
  fileType     String?
  fileSize     Int?
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SarprasFolder {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  rules     SarprasRule[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SarprasCalendarEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  category    String    @default("Lainnya")
  date        DateTime
  endDate     DateTime?
  isPinned    Boolean   @default(false)
  location    String?

  // PIC (Person In Charge)
  pics User[] @relation("CalendarPICs")

  // Recurring fields
  isRecurring       Boolean   @default(false)
  recurringType     String? // DAILY, WEEKLY, MONTHLY, YEARLY
  recurringInterval Int       @default(1)
  recurringDays     String? // e.g. "1,3,5" for Mon, Wed, Fri
  recurringEndDate  DateTime?

  // Assignments linked to this event
  assignments PersonnelAssignment[]

  // Audit
  createdById Int
  createdBy   User     @relation("CalendarCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssetLoan {
  id         Int   @id @default(autoincrement())
  assetId    Int
  asset      Asset @relation(fields: [assetId], references: [id])
  borrowerId Int
  borrower   User  @relation("Borrower", fields: [borrowerId], references: [id])

  unitId       Int // Unit of the asset at the time of loan
  unit         Unit  @relation("UnitLoans", fields: [unitId], references: [id])
  targetUnitId Int? // Destination unit
  targetUnit   Unit? @relation("TargetUnit", fields: [targetUnitId], references: [id])

  requestId String? // UUID to group multiple assets in one request

  borrowDate         DateTime?
  expectedReturnDate DateTime
  actualReturnDate   DateTime?

  purpose String     @db.Text
  status  LoanStatus @default(PENDING)

  reviewedById    Int?
  reviewedBy      User?     @relation("LoanReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusBooking {
  id             Int      @id @default(autoincrement())
  vehicleId      Int
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id])
  isPublic       Boolean  @default(false)
  requesterName  String?
  requesterPhone String?
  unit           String?
  destination    String
  purpose        String?
  startDate      DateTime
  endDate        DateTime
  passengerCount Int      @default(0)
  driverId       Int?
  driver         User?    @relation("BusDriver", fields: [driverId], references: [id])
  token          String?
  isReminderSent Boolean  @default(false)

  // Tracking & Billing
  status      String    @default("APPROVED") // APPROVED, COMPLETED, CANCELLED
  totalKm     Int?
  totalBill   Float?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusUnexpectedExpense {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  description String   @db.Text
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- MANAJEMEN RUMAH DINAS (OFFICIAL RESIDENCE) ---

model OfficialResidenceUnit {
  id         Int     @id @default(autoincrement())
  code       String  @unique // RD-001
  blok       String? // A, B, etc.
  name       String? // Unit A-1
  luas       Float? // in m2
  lantai     Int?    @default(1)
  status     String  @default("KOSONG") // DITEMPATI, KOSONG, MAINTENANCE
  facilities String? @db.Text // JSON string or comma separated list

  residents    OfficialResidenceResident[]
  maintenances OfficialResidenceMaintenance[]
  mous         OfficialResidenceMOU[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficialResidenceResident {
  id        Int                   @id @default(autoincrement())
  nik       String?               @unique
  name      String
  position  String? // Jabatan
  unitId    Int
  unit      OfficialResidenceUnit @relation(fields: [unitId], references: [id])
  startDate DateTime? // Tanggal Masuk
  phone     String?
  status    String                @default("AKTIF") // AKTIF, NON_AKTIF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficialResidenceMaintenance {
  id           Int                   @id @default(autoincrement())
  unitId       Int
  unit         OfficialResidenceUnit @relation(fields: [unitId], references: [id])
  title        String
  description  String                @db.Text
  priority     String                @default("SEDANG") // TINGGI, SEDANG, RENDAH
  status       String                @default("MENUNGGU") // MENUNGGU, DALAM_PENGERJAAN, SELESAI
  reportedDate DateTime              @default(now())
  resolvedDate DateTime?
  technician   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficialResidenceMOU {
  id               Int                   @id @default(autoincrement())
  mouNumber        String                @unique // MOU/DEI/001/2026
  unitId           Int
  unit             OfficialResidenceUnit @relation(fields: [unitId], references: [id])
  residentName     String
  residentPosition String
  startDate        DateTime
  endDate          DateTime
  durationYears    Int
  status           String                @default("AKTIF") // AKTIF, DIPERPANJANG, KADALUARSA
  rights           String?               @db.Text
  obligations      String?               @db.Text
  notes            String?               @db.Text
  signedDate       DateTime?

  // Signatures stored as Base64 strings
  signatureParty1 String? @db.LongText // Pihak Pertama (Yayasan)
  signatureParty2 String? @db.LongText // Pihak Kedua (Penghuni)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PersonnelRoutine {
  id            Int                   @id @default(autoincrement())
  title         String
  description   String                @db.Text
  assignerId    Int
  assigner      User                  @relation("RoutineAssigner", fields: [assignerId], references: [id])
  assigneeId    Int
  assignee      User                  @relation("RoutineAssignee", fields: [assigneeId], references: [id])
  category      String                @default("UMUM")
  priority      String                @default("MEDIUM")
  location      String?
  items         Json?                 @default("[]") // Checklist items template
  frequency     String // DAILY, WEEKLY, MONTHLY
  dayOfWeek     Int? // 0-6 (0=Sun) for WEEKLY
  dayOfMonth    Int? // 1-31 for MONTHLY
  isActive      Boolean               @default(true)
  lastGenerated DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  assignments   PersonnelAssignment[]
}

model PersonnelKPI {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  month           Int // 1-12
  year            Int
  completionRate  Float    @default(0) // 0-100
  punctualityRate Float    @default(0) // 0-100
  reportRate      Float    @default(0) // 0-100
  averageScore    Float    @default(0)
  grade           String? // A, B, C, D
  updatedAt       DateTime @updatedAt

  @@unique([userId, month, year])
}

model WaNotificationTemplate {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique // e.g. BUS_REMINDER_H1, MAINTENANCE_NEW
  name               String // Display name
  category           String // KENDARAAN, PEMELIHARAAN, PENGADAAN, GUDANG, UMUM
  description        String?  @db.Text // Penjelasan kapan notif ini dikirim
  content            String   @db.Text // Template pesan dengan {{placeholder}}
  recipientPositions String?  @db.Text // JSON array of position strings
  availableVars      String?  @db.Text // JSON array of available variables
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// --- MODULE E-OFFICE (DOCUMENT MANAGEMENT) ---

enum OfficeDocumentType {
  SURAT_MASUK
  SURAT_KELUAR
  SURAT_TUGAS
  SURAT_EDARAN
  SURAT_KEPUTUSAN
  SURAT_PESANAN
  BAST
  MOU
  INVOICE
  LAINNYA
}


enum OfficeDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SIGNED
  REJECTED
}

model OfficeDocument {
  id              Int                    @id @default(autoincrement())
  uuid            String                 @unique @default(uuid())
  type            OfficeDocumentType
  number          String?                @unique // Auto-generated: 001/UND/SARPRAS/IV/2026
  date            DateTime               @default(now())
  subject         String
  content         String?                @db.LongText // Rich text body of the letter
  category        String?                // Undangan, Tugas, Keputusan, Keterangan, Pemberitahuan, dll
  priority        String                 @default("BIASA") // BIASA, SEGERA, SANGAT_SEGERA

  // Surat Masuk specifics
  senderName      String?                // Pengirim (for incoming mail)
  senderOrg       String?                // Organisasi pengirim
  receivedDate    DateTime?              // Tanggal diterima
  referenceNumber String?                // Nomor surat pengirim (for incoming)

  // Author / Creator
  authorId        Int
  author          User                   @relation("OfficeDocumentAuthor", fields: [authorId], references: [id])

  // Approval Workflow
  status          OfficeDocumentStatus   @default(DRAFT)
  approvalNote    String?                @db.Text
  rejectionReason String?                @db.Text

  // Signer (Kepala Bidang Sarpras)
  signedById      Int?
  signedBy        User?                  @relation("OfficeDocumentSigner", fields: [signedById], references: [id])
  signedAt        DateTime?
  signatureData   String?                @db.LongText // Base64 signature image
  qrCodeData      String?                @db.Text // QR verification hash

  // Multi-party signatures (BAST / MOU)
  party1Name      String?
  party1Title     String?
  party1Org       String?
  party1Address   String?                @db.Text
  party1Signature String?                @db.LongText
  party1SignedAt  DateTime?
  party2Name      String?
  party2Title     String?
  party2Org       String?
  party2Address   String?                @db.Text
  party2Signature String?                @db.LongText
  party2SignedAt  DateTime?

  // File attachment (for Surat Masuk scanned docs)
  fileUrl         String?                @db.LongText

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

