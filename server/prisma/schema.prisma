generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_ASET
  KEPALA_BIDANG
  ADMIN_UNIT
  AUDITOR
  USER
}

enum Condition {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  DISPOSED
}

enum DisposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  name      String?  // Nama Lengkap
  email     String?  @unique
  nip       String?  @unique
  password  String
  role      Role     @default(USER)
  unitId    Int?
  phone     String?
  position  String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logs      Log[]
  procurements Procurement[]
  validatedAssets Asset[] @relation("AssetValidator")
  vehicleBookings VehicleBooking[]
  maintenances    Maintenance[]
  warehouseTransactions WarehouseTransaction[]
  requestedMovements Movement[]    @relation("RequestedMovements")
  approvedMovements  Movement[]    @relation("ApprovedMovements")
  personnelReports   PersonnelReport[]
  assignedAssignments PersonnelAssignment[] @relation("Assignee")
  createdAssignments  PersonnelAssignment[] @relation("Assigner")
  assignedProcurementItems ProcurementItem[] @relation("ItemAssignee")
  vehicleWeeklyReports VehicleWeeklyReport[]
  authorizedDisposals AssetDisposal[] @relation("Reviewer")
  proposedDisposals   AssetDisposal[] @relation("Proposer")
  sarprasRules        SarprasRule[]
  assetsPIC           Asset[]         @relation("AssetPIC")
}

model Unit {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?
  phone       String?
  email       String?
  address     String?   @db.Text
  headName    String?   // Nama Kepala Unit
  headNip     String?   // NIP Kepala Unit
  logo        String?   @db.LongText // Logo Unit (Base64)
  
  assets      Asset[]
  rooms       Room[]
  users       User[]
  requests    Request[]
  rkbs        RKB[]
  procurements Procurement[]
  maintenances Maintenance[]
}

model Room {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  floor     String
  building  String
  pic       String?
  unitId    Int?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  assets    Asset[]
}

model Category {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  name               String
  usefulLife         Int      // In years
  depreciationMethod String   // e.g. STRAIGHT_LINE
  assets             Asset[]
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  contact   String?
  assets           Asset[]
  procurementItems ProcurementItem[]
}

model Asset {
  id              Int      @id @default(autoincrement())
  code            String   @unique // Format: KB-KT-TH-URUT
  name            String
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id])
  roomId          Int?
  room            Room?    @relation(fields: [roomId], references: [id])
  unitId          Int?
  unit            Unit?    @relation(fields: [unitId], references: [id])
  vendorId        Int?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id])
  
  brand           String?
  specification   String?  @db.Text
  purchaseDate    DateTime
  price           Float
  quantity        Int      @default(1)
  usefulLife      Int      @default(5)
  condition       Condition
  sourceOfFunds   String?  @default("Mandiri")
  acquisitionStatus String? @default("Pembelian")
  
  image           String?
  invoice         String?
  
  // PIC (Person In Charge)
  picId           Int?
  pic             User?    @relation("AssetPIC", fields: [picId], references: [id])
  picName         String?  // For custom PIC names not in system
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  movements       Movement[]
  maintenances    Maintenance[]
  disposal        AssetDisposal?
  
  // Validation Fields
  validationStatus ValidationStatus @default(UNVERIFIED)
  validatedAt      DateTime?
  validatedById    Int?
  validatedBy      User?    @relation("AssetValidator", fields: [validatedById], references: [id])
  validationNote   String?
}

enum ValidationStatus {
  UNVERIFIED
  VALIDATED
  NEEDS_UPDATE
  REJECTED
}

model Request {
  id          Int      @id @default(autoincrement())
  itemName    String
  spec        String?
  qty         Int
  priceEst    Float
  urgency     String
  status      String   // e.g. DRAFT, PENDING, APPROVED, PURCHASED
  unitId      Int
  unit        Unit     @relation(fields: [unitId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Movement {
  id           Int       @id @default(autoincrement())
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id])
  fromLocation String
  toLocation   String
  toRoomId     Int?
  toUnitId     Int?      // New: For Inter-Unit Mutation
  date         DateTime  @default(now())
  reason       String?
  type         String    @default("MUTATION") // MUTATION, DISPOSAL
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requesterId  Int
  requester    User      @relation("RequestedMovements", fields: [requesterId], references: [id])
  approverId   Int?
  approver     User?     @relation("ApprovedMovements", fields: [approverId], references: [id])
  approvalDate DateTime?
  approvalNote String?
}

enum MaintenanceCategory {
  ROUTINE
  INCIDENTAL
}

model Maintenance {
  id            Int      @id @default(autoincrement())
  code          String   @unique // e.g. MT/2026/001
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  unitId        Int
  unit          Unit     @relation(fields: [unitId], references: [id])
  
  type          String   // "ASSET" or "NON_ASSET"
  category      MaintenanceCategory @default(INCIDENTAL)
  assets        Asset[]
  
  title         String   // Judul Ringkas
  description   String   @db.Text // Keluhan / Masalah
  location      String?  // Lokasi (for non-asset)
  photo         String?  @db.LongText // Foto bukti kerusakan (Base64)
  
  status        String   @default("SUBMITTED")
  // SUBMITTED -> APPROVED -> VALIDATED -> ASSIGNED -> IN_PROGRESS -> COMPLETED / REJECTED
  
  // Workflow Fields
  approvalNote    String?
  validationNote  String?
  rejectionReason String?
  technician      String?  // Nama Teknisi / Vendor
  actionTaken     String?  @db.Text // Tindakan Perbaikan
  completionNote  String?  @db.Text
  completionDate  DateTime?
  cost            Float    @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Setting {
  id                Int      @id @default(1)
  orgName           String   @default("Manajemen Aset")
  orgAddress        String?  @db.Text
  orgPhone          String?
  orgEmail          String?
  orgLogo           String?  @db.LongText
  orgHeadName       String?
  orgHeadNip        String?
  assetCodePrefix   String   @default("AST")
  updatedAt         DateTime @updatedAt
}

// --- MODULE PENGADAAN (PROCUREMENT) ---

enum ProcurementStatus {
  DRAFT
  SUBMITTED
  VALIDATED
  APPROVED
  PROCESS
  COMPLETED
  REJECTED
}

enum ProcurementType {
  ASSET
  NON_ASSET
  SERVICE
}

model RKB {
  id          Int       @id @default(autoincrement())
  fiscalYear  Int
  unitId      Int
  unit        Unit      @relation(fields: [unitId], references: [id])
  status      String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  totalBudget Float     @default(0)
  items       RKBItem[]
  procurements Procurement[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RKBItem {
  id          Int      @id @default(autoincrement())
  rkbId       Int
  rkb         RKB      @relation(fields: [rkbId], references: [id])
  name        String
  spec        String?  // Spesifikasi
  qty         Int
  unit        String   // Satuan (Unit, Pcs, Box)
  estPrice    Float
  category    String   // ASSET / NON_ASSET
  priority    String   // HIGH, MEDIUM, LOW
  month       Int?     // 1-12
}

model Procurement {
  id          Int       @id @default(autoincrement())
  code        String    @unique // e.g. REQ/2024/001
  title       String?   // Judul Pengajuan (e.g. Pengadaan Laptop Divisi IT)
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  unitId      Int
  unit        Unit      @relation(fields: [unitId], references: [id])
  
  type        ProcurementType
  status      ProcurementStatus @default(DRAFT)
  
  rkbId       Int?
  rkb         RKB?      @relation(fields: [rkbId], references: [id])
  
  validationNote String?
  rejectionReason String?
  
  bastDate    DateTime?
  bastFile    String?
  
  items       ProcurementItem[]
  offers      VendorOffer[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProcurementItem {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  name          String
  spec          String?     @db.Text
  qty           Int
  unit          String      // pcs, set, unit
  estPrice      Float       @default(0)
  
  // New Fields for Detailed Processing
  fundingSource String?     // Sumber Dana per item
  comparisonVendors String? @db.Text // JSON String: [{ name, price, notes }, ...]
  needComparison Boolean @default(true) // Perlu perbandingan harga?
  
  // Post-Approval Fields
  vendorId      Int?
  vendor        Vendor?     @relation(fields: [vendorId], references: [id])
  brand         String?     // Merk/Type
  usefulLife    Int?        // Umur Manfaat (Tahun)
  finalPrice    Float?      // Harga Akhir / Realisasi
  
  // Assignment Fields
  assignedTo    String?     // Nama (Internal/Manual)
  assignedToId  Int?
  assignedToUser User?      @relation("ItemAssignee", fields: [assignedToId], references: [id])
}

model VendorOffer {
  id            Int         @id @default(autoincrement())
  procurementId Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  vendorId      Int?        // Optional hyperlink to master Vendor
  vendorName    String      // Manual name if vendor not in master
  price         Float
  isWinner      Boolean     @default(false)
  quoteFile     String?
  createdAt     DateTime    @default(now())
}
// --- MANAJEMEN KENDARAAN ---

model Vehicle {
  id            Int       @id @default(autoincrement())
  name          String    // Nama
  brand         String    // Merk
  model         String?   // Model
  type          String    // Tipe Kendaraan (e.g. Minibus, Pickup, Motor)
  plateNumber   String    @unique // Plat Nomor
  fuelType      String?   // Bahan Bakar
  capacity      String?   // Kapasitas (e.g. 1500cc)
  color         String?   // Warna
  odometer      Int       @default(0) // Kilometer saat ini
  photo         String?   @db.LongText // Foto Kendaraan (Base64 support)
  status        String    @default("ACTIVE") // ACTIVE / INACTIVE
  
  // Additional fields (kept from previous version)
  year          Int?
  chassisNumber String?   // No Rangka
  engineNumber  String?   // No Mesin
  taxDueDate    DateTime? // Pajak Tahunan
  stnkDueDate   DateTime? // Pajak 5 Tahunan
  
  // Relations
  assetId       Int?      @unique // Optional link to Asset table
  bookings      VehicleBooking[]
  services      VehicleService[]
  fuelLogs      VehicleFuelLog[]
  weeklyReports VehicleWeeklyReport[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Notification Tracking
  lastKmNotifiedAt DateTime? // Track last time KM service warning was sent
}

model VehicleWeeklyReport {
  id              Int      @id @default(autoincrement())
  vehicleId       Int
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  
  weekStartDate   DateTime
  weekEndDate     DateTime
  
  startOdometer   Int
  endOdometer     Int
  
  conditionEngine   String  // e.g. BAIK, PERLU PERBAIKAN
  conditionBody     String
  conditionInterior String
  isClean           Boolean @default(true)
  
  notes             String? @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VehicleBooking {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  driverName  String?  // If driver is external or specific
  destination String
  purpose     String?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, CANCELLED
  adminNote   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VehicleService {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  date        DateTime
  category    String   @default("ROUTINE") // ROUTINE, NON_ROUTINE
  type        String   // SERVICE_RUTIN, GANTI_OLI, PAJAK, PERBAIKAN, OTHER
  description String
  cost        Float
  odometer    Int?
  nextServiceOdometer Int? // KM service berikutnya (Routine only)
  workshop    String?  // Bengkel
  proofFile   String?  // Foto Nota
  
  createdAt   DateTime @default(now())
}

model VehicleFuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  date        DateTime
  liters      Float
  cost        Float
  odometer    Int
  proofFile   String?
  
  createdAt   DateTime @default(now())
}

// --- MANAJEMEN GUDANG & LOGISTIK ---

model WarehouseCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique // "Seragam", "Perlengkapan Sekolah"
  items WarehouseItem[]
}

model WarehouseItem {
  id            Int      @id @default(autoincrement())
  code          String   @unique // GD/SRG/001
  name          String   // "Baju Putih", "Buku Tulis"
  categoryId    Int
  category      WarehouseCategory @relation(fields: [categoryId], references: [id])
  
  type          String?  // BAJU, CELANA, JILBAB (seragam only)
  gender        String?  // L, P (seragam only)
  size          String?  // S, M, L, XL, XXL (seragam only)
  purchaseYear  Int?     // Tahun pembuatan/pembelian batch (wajib utk seragam)
  itemUnit      String?  // Unit seragam: TK, TAUD, SD, SMP, SMA, dll
  uniformGroup  String?  // Nasional, Batik, Muslim, Pramuka, Olahraga, Jubah Hitam, Jubah Putih
  
  stock         Int      @default(0)
  minStock      Int      @default(5)
  purchasePrice Float?   // Harga beli per unit
  supplier      String?  // Pemasok
  location      String?  // Rak / lokasi gudang
  
  transactionItems WarehouseTransactionItem[]
  orderItems       UniformOrderItem[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WarehouseTransaction {
  id          Int      @id @default(autoincrement())
  code        String   @unique // TRX/2026/001
  type        String   // "IN" or "OUT"
  date        DateTime
  note        String?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  items       WarehouseTransactionItem[]
  
  createdAt   DateTime @default(now())
}

model WarehouseTransactionItem {
  id              Int      @id @default(autoincrement())
  transactionId   Int
  transaction     WarehouseTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemId          Int
  item            WarehouseItem @relation(fields: [itemId], references: [id])
  quantity        Int
  recipientName   String?  // Penerima (for OUT)
  recipientUnit   String?  // Unit penerima
}

// --- PESANAN SERAGAM PUBLIK ---

model UniformOrder {
  id            Int      @id @default(autoincrement())
  code          String   @unique  // ORD/2026/001
  customerName  String             // Nama pemesan (ortu/wali)
  customerPhone String             // No HP pemesan
  customerUnit  String             // Unit: TK, SD, SMP, dll
  studentName   String             // Nama siswa
  studentClass  String?            // Kelas
  note          String?
  status        String   @default("PENDING") // PENDING, CONFIRMED, READY, PICKED_UP, CANCELLED
  totalAmount   Float    @default(0)
  items         UniformOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UniformOrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         UniformOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId        Int?     // Made optional for decoupled orders
  item          WarehouseItem? @relation(fields: [itemId], references: [id])
  itemName      String?  // For decoupled orders
  size          String?  // For decoupled orders
  quantity      Int
  price         Float    @default(0)
  status        String   @default("PENDING") // PENDING, READY, NO_STOCK, DONE
  pickupDetails String?  // Info like "Senin, 07.30 - 16.00"
}

enum ReportType {
  DAILY
  WEEKLY
}

enum PersonnelReportCategory {
  KEUANGAN
  ASET
  GUDANG
  KENDARAAN
  UMUM
}

model PersonnelReport {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      ReportType
  category  PersonnelReportCategory @default(UMUM)
  content   String   @db.Text
  metadata  Json?    // Structured data for specific categories
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PersonnelAssignment {
  id          Int      @id @default(autoincrement())
  assignerId  Int
  assigner    User     @relation("Assigner", fields: [assignerId], references: [id])
  assigneeId  Int
  assignee    User     @relation("Assignee", fields: [assigneeId], references: [id])
  title       String
  description String   @db.Text
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssetDisposal {
  id           Int      @id @default(autoincrement())
  assetId      Int      @unique
  asset        Asset    @relation(fields: [assetId], references: [id])
  disposalDate DateTime?
  reason       String   
  method       String?  
  notes        String?  @db.Text
  status       DisposalStatus @default(PENDING)
  proposedById Int
  proposedBy   User   @relation("Proposer", fields: [proposedById], references: [id])
  reviewedById Int?
  reviewedBy   User?  @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectionReason String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SarprasRule {
  id            Int           @id @default(autoincrement())
  title         String
  category      String        @default("Umum")
  folderId      Int?
  folder        SarprasFolder? @relation(fields: [folderId], references: [id])
  description   String?       @db.Text
  fileUrl       String        @db.LongText
  fileName      String
  fileType      String?
  fileSize      Int?
  uploadedById  Int
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SarprasFolder {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  rules     SarprasRule[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
